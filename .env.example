# MongoDB Atlas connection string.
# Include the database name before the query string, e.g. .../soloLeveling?retryWrites=true
MONGODB_URI=

# Port for local development. Hosting platforms usually inject their own.
PORT=3001

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=